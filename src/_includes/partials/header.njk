{# ===================== Site header / primary navigation ===================== #}
<a class="skip-link" href="#main">Skip to content</a>

<header class="site-header" data-site-header>
  <div class="site-header__inner">
    <a class="wordmark" href="/">{{ site.title }}</a>

    <div class="header-right">
      <nav class="primary-nav" id="primary-nav" aria-label="Primary" data-nav-menu>
        <ul class="primary-nav__list">
          {% for item in nav %}
          {% set isCurrent = (item.url == page.url) or (item.url != "/" and page.url.startsWith(item.url) and item.url.length > 1 and not item.url.startsWith("/#")) %}
          <li>
            <a
              class="primary-nav__link"
              href="{{ item.url }}"
              {% if isCurrent %}aria-current="page"{% endif %}
            >{{ item.label }}</a>
          </li>
          {% endfor %}
          <li>
            <a class="btn btn--pill nav-cta" href="/#contact">
              <span class="status-dot" aria-hidden="true"></span>
              Open to work
            </a>
          </li>
        </ul>
      </nav>

      <button
        class="theme-toggle"
        type="button"
        data-theme-toggle
        aria-pressed="false"
        aria-label="Switch colour theme"
      >
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
      </button>

      <button
        class="nav-toggle"
        type="button"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="primary-nav"
        aria-label="Toggle navigation menu"
      >
        <span class="nav-toggle__bar" aria-hidden="true"></span>
        <span class="nav-toggle__bar" aria-hidden="true"></span>
        <span class="nav-toggle__bar" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>
