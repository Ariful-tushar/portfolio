{# ============================== About ============================== #}
<section class="section about" id="about">
  <div class="container about__inner">
    <div class="about__media">
      <img
        class="about__photo"
        src="{{ person.hero.photo }}"
        alt="{{ person.hero.photoAlt }}"
        width="480"
        height="580"
        loading="lazy"
      />
    </div>

    <div class="about__body">
      <h2 class="section__title section__title--left">{{ person.about.heading }}</h2>
      {% for para in person.about.paragraphs %}
      <p>{{ para }}</p>
      {% endfor %}

      {% if person.cv %}
      <a class="btn btn--primary about__cv" href="{{ person.cv }}" download>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        Download CV
      </a>
      {% endif %}
    </div>
  </div>
</section>
